<h1>Events</h1>

<%= link_to "New Event", new_event_path %>

<ul>
  <% @events.each do |event| %>
    <li>
      <%= link_to event.title, event_path(event) %>
      <%= link_to "Edit", edit_event_path(event) %>

      <%= button_to "Delete", event_path(event),
          method: :delete,
          data: { turbo_confirm: "Are you sure?" } %>
    </li>
  <% end %>
</ul>